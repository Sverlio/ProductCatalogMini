@model IEnumerable<ProductCatalogData.Entities.Product>

@{
    ViewData["Title"] = "Продукти";
}

<h1>Продукти</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Добави продукт</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Продукт</th>
            <th>Цена</th>
            <th>Наличност</th>
            <th>Статус</th>
            <th>Категория</th>
            <th>Доставчик</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price.ToString("0.00")</td>
                <td>@item.StockQuantity</td>
                <td>@item.Status</td>
                <td>@item.Category?.Name</td>
                <td>@item.Supplier?.CompanyName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Редактирай</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Детайли</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>