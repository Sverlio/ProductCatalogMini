@using ProductCatalogMini.ViewModels.Products
@model ProductsIndexViewModel

@{
    ViewData["Title"] = "Продукти";
}

<h1>Продукти</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Нов продукт</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Име</th>
            <th>Марка</th>
            <th>Цена</th>
            <th>Наличност</th>
            <th>Статус</th>
            <th>Категория</th>
            <th>Доставчик</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Products)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Brand</td>
                <td>@item.Price.ToString("F2")</td>
                <td>@item.StockQuantity</td>
                <td>@item.Status</td>
                <td>@item.CategoryName</td>
                <td>@(item.SupplierName ?? "—")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Редакция</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Детайли</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Изтриване</a>
                </td>
            </tr>
        }
    </tbody>
</table>