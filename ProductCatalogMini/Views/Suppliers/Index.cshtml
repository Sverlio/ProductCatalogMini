@using ProductCatalogMini.ViewModels.Suppliers
@model SuppliersIndexViewModel

@{
    ViewData["Title"] = "Доставчици";
}

<h1>Доставчици</h1>

@if (!Model.Suppliers.Any())
{
    <p class="text-muted">Няма добавени доставчици.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Фирма</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var supplier in Model.Suppliers)
            {
                <tr>
                    <td>@supplier.Id</td>
                    <td>@supplier.CompanyName</td>
                </tr>
            }
        </tbody>
    </table>
}