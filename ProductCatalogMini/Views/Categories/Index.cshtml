@using ProductCatalogMini.ViewModels.Categories
@model CategoriesIndexViewModel

@{
    ViewData["Title"] = "Категории";
}

<h1>Категории</h1>

@if (!Model.Categories.Any())
{
    <p class="text-muted">Няма добавени категории.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Име</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                </tr>
            }
        </tbody>
    </table>
}